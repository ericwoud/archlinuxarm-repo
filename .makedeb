# Build debian package for architecture: aarch64
# prefix = "pool/main" 
function dependsdeb {
  (source "${startdir}/PKGBUILD"
   for deb in ${depends_debian[*]}; do echo -n " -d ${deb}"; done)
}
function makedeb {
  echo "Building .deb for package ${pkgname} in ${prefix} from $(basename ${pkgtar})" >&2
  dependsdeb >&2
  fpm -f -s pacman -t deb -x ".BUILDINFO" $(dependsdeb) -p "${prefix}" "${pkgtar}"
}
