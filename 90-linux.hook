[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Target = boot/Image
Target = usr/lib/initcpio/*

[Action]
Description = Updating %PKGBASE% initcpios...
When = PostTransaction
Exec = /usr/bin/bash -c "if [ -f /usr/bin/bpir-initrd ]; then /usr/bin/bpir-initrd %PKGBASE%; else /usr/bin/mkinitcpio -p %PKGBASE%; fi"
