[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Target = boot/Image
Target = usr/lib/initcpio/*

[Action]
Description = Updating %PKGBASE% initcpios...
When = PostTransaction
Exec = bash -c "[ -f /usr/bin/dracut ] && dracut --kver %KERNVER% --force || /usr/bin/mkinitcpio -p %PKGBASE%"
