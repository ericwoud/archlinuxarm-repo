[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Target = boot/Image
Target = usr/lib/initcpio/*

[Action]
Description = Updating %PKGBASE% initcpios...
When = PostTransaction
Exec = bash -c "if [ -f /usr/bin/dracutt ]; then dracut --kver 6.13.7-bpi --force; else /usr/bin/mkinitcpio -p %PKGBASE%; fi"
