post_upgrade() {
  local pb="linux-${1##*.}-git"
  [ -f /usr/bin/bpir-initrd ] && /usr/bin/bpir-initrd "${pb}" || /usr/bin/mkinitcpio -p "${pb}"
  /usr/bin/bpir-toolbox --write2fip
}

post_install() {
  post_upgrade "$@"
}

post_remove() {
  rm -f /boot/initramfs-linux-bpir64-git.img
  rm -f /boot/initramfs-linux-bpir64-git-fallback.img
}
