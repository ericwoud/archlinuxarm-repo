post_upgrade() {
  local f
  for f in $(basename /etc/initcpio/install/linux-bpir*-git); do
    [ -f /usr/bin/bpir-initrd ] && /usr/bin/bpir-initrd "${f}" || /usr/bin/mkinitcpio -p "${f}"
  done
  /usr/bin/bpir-toolbox --write2fip
}

post_install() {
  post_upgrade "$@"
}

post_remove() {
  rm -f /boot/initramfs-linux-bpir64-git.img
  rm -f /boot/initramfs-linux-bpir64-git-fallback.img
}
