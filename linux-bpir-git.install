_get_kver() {
  grep -H "${1}" /lib/modules/*/pkgversion | cut -d: -f1 | xargs dirname | xargs basename
}

post_upgrade() {
  echo "Kernel version: $(_get_kver $1)"
  /usr/bin/bpir-toolbox --write2fip
}

post_install() {
  post_upgrade "$@"
}

post_remove() {
  rm -f /boot/initramfs-linux-bpir64-git.img
  rm -f /boot/initramfs-linux-bpir64-git-fallback.img
}
