post_upgrade() {
  echo $0
  [ -f /usr/bin/bpir-initrd ] && /usr/bin/bpir-initrd %PKGBASE% || /usr/bin/mkinitcpio -p %PKGBASE%
  /usr/bin/bpir-toolbox --write2fip
}

post_install() {
  post_upgrade
}

post_remove() {
  rm -f /boot/initramfs-linux-bpir64-git.img
  rm -f /boot/initramfs-linux-bpir64-git-fallback.img
}
