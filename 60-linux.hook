[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/%KERNVER%/*
Target = usr/lib/modules/%EXTRAMODULES%/*

[Action]
Description = Updating %PKGBASE% module dependencies...
When = PostTransaction
Exec = bash -c "[ -f /usr/bin/depmod ] && /usr/bin/depmod %KERNVER% || /usr/sbin/depmod %KERNVER%"
