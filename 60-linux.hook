[Trigger]
Type = File
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/%KERNVER%/*
Target = usr/lib/modules/%EXTRAMODULES%/*

[Action]
Description = Updating %PKGBASE% module dependencies...
When = PostTransaction
Exec = /usr/bin/bash -c "if [ -f /usr/sbin/depmod ]; then /usr/sbin/depmod %KERNVER%; else /usr/bin/depmod %KERNVER%; fi"
